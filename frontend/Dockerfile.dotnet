# Same build as Dockerfile, just proxying /api to the .NET backend
# (bookworm-api:8080) instead of the Java one (backend:8080) - see
# nginx.dotnet.conf vs nginx.conf.

# ---- Build stage ----
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# ---- Serve stage ----
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.dotnet.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
